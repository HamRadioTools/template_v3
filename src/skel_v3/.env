# Execution mode, api or worker.
APP_TYPE=api
WORKER_MODE=oneshot
WORKER_POLL_INTERVAL=5

# Service environment: local, dev, test, staging, prod, ...
SERVICE_ENV=local
SERVICE_NAME=skel-service
SERVICE_VERSION=0.1.0
SERVICE_NAMESPACE=default

# Logging
# If left unspecified: DEBUG in local (default)
LOG_LEVEL=INFO

# Postgres
PG_ENABLED=false
PG_HOST=postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DBNAME=postgres
PG_MIN_CONN=1
PG_MAX_CONN=5
# PG_SSLMODE=disable

# Redis
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONN=20
